{
  "manifest_version": 3,
  "name": "SecureVault",
  "version": "1.0.0",
  "description": "Fill logins from your local SecureVault. Fills only on the exact saved site, only when you click.",
  "key": "",
  "minimum_chrome_version": "127",
  "permissions": ["nativeMessaging", "scripting", "activeTab"],
  "host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "SecureVault", "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["https://*/*"], "js": ["detect.js"], "run_at": "document_idle", "all_frames": false }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
